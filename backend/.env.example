# Database connection (Neon Postgres with pgvector or local Docker)
DATABASE_URL=postgresql+psycopg://citelock:citelock_dev_password@localhost:5432/citelock

# Firebase Admin configuration (Backend only)
# Path to service account JSON file OR raw inline JSON string
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id"}
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# Storage Provider configuration (firebase or none for local dev)
STORAGE_PROVIDER=firebase

# LLM Provider configuration (openai, gemini, groq, or mock)
# Set to 'mock' for local offline development without API keys.
# Groq serves the LLM only (no embeddings); keep EMBEDDING_PROVIDER on gemini or openai.
LLM_PROVIDER=gemini
LLM_API_KEY=sk-placeholder-llm-key

# Embedding Provider configuration (openai, gemini, or mock)
# Set to 'mock' for local offline development without API keys
EMBEDDING_PROVIDER=gemini
EMBEDDING_API_KEY=sk-placeholder-embedding-key
EMBEDDING_DIM=768

# Model IDs
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Gemini model IDs must be checked against currently available models.
GEMINI_LLM_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Optional: Groq picks an available chat model automatically if this one is missing
GROQ_LLM_MODEL=llama-3.3-70b-versatile

# Self-Correction Configuration
MAX_CORRECTION_RETRIES=3

# Wall-clock budget for one pipeline run (seconds); checked before each graph node starts
PIPELINE_TIMEOUT_SECONDS=300
# Claim verification concurrency (1 keeps free-tier LLM rate limits happy)
MAX_VERIFICATION_WORKERS=1
# Per-request read timeout for model providers (seconds)
HTTP_READ_TIMEOUT=60

# Ingestion & Chunking Configuration
CHUNK_SIZE=500
CHUNK_OVERLAP=50
MAX_FILE_SIZE_MB=25

# CORS Configuration (comma-separated list of origins, no trailing slash needed)
# *.vercel.app and *.onrender.com origins are also allowed by pattern in app/main.py
CORS_ORIGINS=http://localhost:3000,https://citelock.vercel.app

# Environment & Auth Security Policy
# Dev auth bypass requires BOTH ENVIRONMENT=development AND ALLOW_DEV_AUTH=true.
# In production, missing required keys fail at startup, and ALLOW_DEV_AUTH is rejected.
# In development, invalid tokens strictly return 401 Unauthorized.
ENVIRONMENT=development
ALLOW_DEV_AUTH=false
